{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "reported",
        "withdrawn"
      ]
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_url": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "status",
    "entry_sha256",
    "reviewed_by",
    "reviewed_at",
    "evidence_url",
    "notes"
  ],
  "additionalProperties": false
}

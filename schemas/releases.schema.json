{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "evaluator_repository": {
            "type": "string",
            "minLength": 1
          },
          "code_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evaluator_image_digest": {
            "type": "string",
            "pattern": "^.+@sha256:[a-f0-9]{64}$"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tasks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "frozen_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reference_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cells": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "v1": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "v1-plus": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "v1",
                      "v1-plus"
                    ],
                    "additionalProperties": false
                  }
                },
                "evaluation_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "frozen_sha256",
                "reference_sha256",
                "cells",
                "evaluation_sha256"
              ],
              "additionalProperties": false
            }
          },
          "eval_versions": {
            "type": "array",
            "items": {
              "enum": [
                "v1",
                "v1-plus"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "datasets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "required": [
                "uri",
                "revision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "evaluator_repository",
          "code_commit",
          "manifest_sha256",
          "evaluator_image_digest",
          "models",
          "tasks",
          "eval_versions",
          "datasets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "releases"
  ],
  "additionalProperties": false
}
